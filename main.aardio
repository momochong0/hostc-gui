// ========== 全局状态 ==========
var hostcProc = null;   // hostc 进程
var readTimerId = null; // 读取输出的定时器
var readyUrl = "";      // 当前公网地址
var onProcEnded;        // 进程结束复位函数（前置声明）

// hostc 入口：优先 npm 全局目录，其次本地离线目录
// 1.x 入口 dist/index.js；2.x 入口 dist/hostc.mjs（node 都能直接启动，进程干净易清理）
var globalRoot = null;   // npm 全局 node_modules
var localRoot = null;    // 本软件自带/离线释放的 hostc 所在目录
var hostcEntry = null;   // 实际使用的入口文件
var hostcMajor = 0;      // 入口主版本号（1 或 2）
var nodeVersion = null;

// 本地离线安装目录：EXE 旁的 hostc-data（绿色、无需写系统目录）
var appDir = io.fullpath("/");
localRoot = io.joinpath(appDir, "hostc-data");

// 检测系统是否安装 Node.js；成功返回 true 并记录版本号到 nodeVersion
var checkNode = function(){
	var p = process.popen.cmd("node --version");
	var out = p.readAll();
	if(out){
		var v = string.trim(out);
		if(string.find(v, "^v?\d+\.\d+")){
			nodeVersion = v;
			return true;
		}
	}
	nodeVersion = null;
	return false;
};

// 未检测到 Node 时弹窗引导用户安装（可选打开官方下载页）
var promptInstallNode = function(){
	var ok = winform.msgboxTest(
		'未检测到 Node.js 运行环境。\r\n\r\n'
		++ 'hostc 基于 Node.js 运行，请先安装 Node.js（建议下载 LTS 长期支持版），\r\n'
		++ '安装完成后重新打开本软件即可。\r\n\r\n'
		++ '是否现在打开 Node.js 官方下载页面？'
		, '需要安装 Node.js');
	if(ok){
		process.execute("https://nodejs.org/zh-cn/download");
	}
};

// 读取某个 hostc 安装目录的版本号（package.json）
var readPkgVersion = function(base){
	var data = string.load(io.joinpath(base, "hostc\package.json"));
	if(!data) data = string.load(io.joinpath(base, "package.json"));
	if(data){
		var pkg = JSON.parse(data);
		if(pkg && pkg.version) return tostring(pkg.version);
	}
	return null;
};

// 解析当前可用的 hostc 入口（npm 全局优先，其次本地离线），更新 hostcEntry/hostcMajor
var resolveHostc = function(){
	hostcEntry = null;
	hostcMajor = 0;
	var tryBase = function(base){
		if(!base) return false;
		// 2.x
		var mjs = io.joinpath(base, "hostc\dist\hostc.mjs");
		if(io.exist(mjs)){ hostcEntry = mjs; hostcMajor = 2; return true; }
		// 1.x
		var js = io.joinpath(base, "hostc\dist\index.js");
		if(io.exist(js)){ hostcEntry = js; hostcMajor = 1; return true; }
		return false;
	};
	if(tryBase(globalRoot)) return true;
	if(tryBase(localRoot)) return true;
	return false;
};

// 先确认 Node 可用，再解析 npm 全局目录
if(checkNode()){
	var pr = process.popen.cmd("npm root -g");
	globalRoot = string.trim(pr.readAll());
	if(!#globalRoot) globalRoot = null;
}
resolveHostc();

// ========== 工具函数 ==========

// 追加日志（时间戳），edit 控件换行必须用 \r\n
var log = function(...){
	var args = {...};
	var line = time().format("%H:%M:%S") + "  ";
	for(i=1;#args){
		if(i > 1) line ++= " ";
		line ++= tostring(args[i]);
	}
	winform.editLog.text ++= line ++ '\r\n';
};

// 更新状态显示
var setState = function(text, colorBgr){
	winform.stateText.text = text;
	winform.stateDot.bgcolor = colorBgr;
	winform.stateDot.redraw();
};

// 安装/更新期间批量禁用或恢复操作按钮（隧道停止键由运行状态单独管理）
var setButtonsBusy = function(busy){
	winform.btnInstall.disabled = busy;
	winform.btnDoctor.disabled = busy;
	winform.btnStart.disabled = busy;
	winform.btnUpdateHostc.disabled = busy;
	winform.btnUpdateApp.disabled = busy;
};

// 固定的本地回环主机与官方服务器（hostc 2.x 默认服务器域名）
var LOCAL_HOST = "127.0.0.1";
var SERVER_HOST = "hostc.app";

// 软件（本面板）自身版本；约定：随内置 hostc 版本同步，当前内置 hostc 为 2.0.4
var APP_VERSION = "2.0.4";
var REPO_OWNER = "momochong0";
var REPO_NAME = "hostc-gui";
var RELEASES_URL = "https://github.com/" ++ REPO_OWNER ++ "/" ++ REPO_NAME ++ "/releases";

// 刷新「版本与维护」卡片：软件版本固定显示，hostc 版本实时解析
// 返回权威 hostc 版本号（null=未安装），供隧道状态等处复用，保证两处版本始终一致
var refreshVersionDisplay = function(){
	winform.txtAppVer.text = "v" ++ APP_VERSION;
	resolveHostc();
	var hv = null;
	if(hostcEntry){
		var base = io.exist(io.joinpath(globalRoot,"hostc")) ? globalRoot : localRoot;
		hv = readPkgVersion(base);
		winform.txtHostcVer.text = hv ? ("v" ++ tostring(hv)) : "未知";
	}
	else {
		winform.txtHostcVer.text = "未安装";
	}
	return hv;
};

// 根据端口输入框实时更新「本地地址」；端口非法时清空，避免显示错误地址
var syncLocalAddress = function(){
	var port = tonumber(winform.editPort.text);
	if(port && port >= 1 && port <= 65535){
		winform.editLocal.text = "http://" ++ LOCAL_HOST ++ ":" ++ port ++ "/";
	}
	else {
		winform.editLocal.text = "";
	}
};

// 从输出文本中提取公网 URL
// 2.x: "  https://xxxx.hostc.app  → http://localhost:3000"
// 1.x: "Public URL: https://xxxx.hostc.dev"
var parseFields = function(text){
	var r = {};
	// 注意：aardio 模式里 ':' 是元字符，字面冒号必须转义为 '\:'
var url = string.match(text, "(https\://[a-z0-9][a-z0-9-]*\.hostc\.[a-z]+)");
	if(url) r.url = url;
	else {
		var pos = string.indexOf(text, "Public URL:");
		if(pos) r.url = string.trim(string.match(string.slice(text, pos + 11), "[^\r\n]+"));
	}
	return r;
};

// 停止读取定时器
var stopReadTimer = function(){
	if(readTimerId){
		winform.clearInterval(readTimerId);
		readTimerId = null;
	}
};

// ========== 启动 / 停止 ==========

var startTunnel = function(){
	// 0. 必须先有 Node.js 运行环境
	if(!checkNode()){
		log("未检测到 Node.js，无法启动隧道。");
		promptInstallNode();
		return;
	}

	// 1. 校验参数
	var port = tonumber(winform.editPort.text);
	if(!port || port < 1 || port > 65535){
		winform.msgbox("请输入有效的端口号（1-65535）");
		return;
	}
	// 2. 检查 hostc 是否已安装（缺失则自动走多级安装容错）
	if(!resolveHostc()){
		if( ! winform.msgboxTest('尚未检测到 hostc，是否立即安装？\n将依次尝试官方源、国内镜像与内置离线包。')) return;
		if(!installHostc(false)) return;
	}

	// 3. 检查本地端口是否可连接（连不上仅提示，不阻断）
	var tcp = wsock.tcp.client();
	var portOpen = tcp.connectTimeout(LOCAL_HOST, port, 1.5);
	if(!portOpen){
		if( ! winform.msgboxTest('本地 ' ++ LOCAL_HOST ++ ':' ++ port ++ ' 似乎还没有服务在监听。\n仍然继续启动隧道吗？')) return;
	}

	// 4. 构造参数并启动进程（2.x 目标直接写端口；使用默认官方服务器，无需 --server）
	var args = [hostcEntry, tostring(port)];

	hostcProc = process.popen("node", args);
	hostcProc.codepage = 65001;

	// 5. 切换界面状态
	readyUrl = "";
	winform.editUrl.text = "";
	syncLocalAddress();
	winform.btnStart.disabled = true;
	winform.btnStop.disabled = false;
	winform.btnQr.disabled = true;
	setState("正在创建隧道...", 0xF5A623);
	log("启动隧道：本地 " ++ LOCAL_HOST ++ ":" ++ port ++ "（hostc " ++ hostcMajor ++ ".x）");

	// 6. 定时读取输出
	var pending = "";  // 未完成的残行
	var allOut = "";   // 完整输出（用于字段解析）
	var gotReady = false;
	readTimerId = winform.setInterval(
		function(){
			var proc = hostcProc;   // 局部快照：peek 消息泵期间 hostcProc 可能被重入的停止操作置空
			if(!proc) return 0;
			var chunk = proc.peek(100);
			if(chunk){
				allOut ++= chunk;

				// 按行输出到日志
				var combined = pending ++ chunk;
				var start = 1;
				while(true){
					var nl = string.indexOf(combined, '\n', start);
					if(!nl) break;
					var ln = string.trim(string.slice(combined, start, nl - 1));
					if(#ln) log(ln);
					start = nl + 1;
				}
				pending = string.slice(combined, start);

				if(!gotReady){
					var f = parseFields(allOut);
					if(f.url){
						gotReady = true;
						readyUrl = f.url;
						if(readyUrl[#readyUrl] != 47) readyUrl ++= "/";
						winform.editUrl.text = readyUrl;
						setState("隧道运行中", 0x34A853);
						winform.btnQr.disabled = false;
						log("隧道已就绪：" ++ readyUrl);
					}
				}
			}

			// 进程意外退出（重入停止后 hostcProc 可能已被置空，此时无需再处理）
			if(hostcProc != proc) return 0;
			var active = call(function(){ return proc.stillActive(); });
			if(!active){
				log("hostc 进程已退出。");
				onProcEnded(false);
				return 0;
			}
		},
		300
	);
};

// 进程结束后的界面复位；normalStop 表示用户主动停止
onProcEnded = function(normalStop){
	stopReadTimer();
	hostcProc = null;
	readyUrl = "";
	winform.editUrl.text = "";
	winform.btnStart.disabled = false;
	winform.btnStop.disabled = true;
	winform.btnQr.disabled = true;
	setState(normalStop ? "已停止" : "已断开", normalStop ? 0x9AA0A6 : 0xEA4335);
};

// 安全终止进程对象：容忍进程恰好刚结束、句柄已释放等情况，绝不向上抛错
var killProcSafe = function(proc){
	if(!proc) return;
	// 仍存活才需要强杀；已退出直接跳过（对已退出进程 terminate 可能抛错）
	var alive = call(function(){ return proc.stillActive(); });
	if(alive){
		call(function(){ proc.terminate(); });
	}
	else {
		// 进程已退出，仅释放管道（close 不会关闭目标进程），容错执行
		call(function(){ proc.close(); });
	}
};

var stopTunnel = function(){
	if(!hostcProc) return;
	var proc = hostcProc;
	log("正在停止隧道 ...");
	stopReadTimer();
	hostcProc = null;          // 先摘引用，避免定时器/其它路径再访问
	killProcSafe(proc);
	onProcEnded(true);
	log("隧道已停止。");
};

// ========== 安装 / 修复 hostc（多级容错） ==========
// 安装顺序：官方 npm → 国内 npmmirror → 内置离线包（EXE 内嵌，免联网）
// verbose=true 由按钮触发（已弹窗确认）；返回是否安装成功
installHostc = function(verbose){
	setState("正在安装 hostc...", 0xF5A623);
	setButtonsBusy(true);

	var ok = false;
	var usedWay = "";

	// —— 第 1 级：官方 npm ——
	log("① 尝试通过官方 npm 源安装 ...");
	var p1 = process.popen.cmd("npm install -g hostc@latest");
	var o1, e1 = p1.readAll();
	if(resolveHostc()){ ok = true; usedWay = "官方 npm 源"; }

	// —— 第 2 级：国内镜像 ——
	if(!ok){
		log("① 官方源失败，② 尝试国内 npmmirror 镜像 ...");
		var p2 = process.popen.cmd("npm install -g hostc@latest --registry=https://registry.npmmirror.com");
		var o2, e2 = p2.readAll();
		if(resolveHostc()){ ok = true; usedWay = "国内 npmmirror 镜像"; }
	}

	// —— 第 3 级：内置离线包 ——
	if(!ok){
		log("② 镜像安装失败，③ 释放内置离线包（无需联网）...");
		if(extractBundledOffline()){
			if(resolveHostc()){ ok = true; usedWay = "内置离线包"; }
		}
	}

	setButtonsBusy(false);
	if(ok){
		// 唯一数据源：refreshVersionDisplay 刷新「版本与维护」并返回权威版本号
		var ver = refreshVersionDisplay();
		log("hostc 安装成功（" ++ usedWay ++ "），版本 " ++ tostring(ver) ++ "。");
		// 隧道状态使用同一版本号，保证两处完全一致
		setState(ver ? ("已安装 hostc " ++ tostring(ver)) : "已安装 hostc", 0x34A853);
		if(verbose) winform.msgbox('hostc 安装成功！\n来源：' ++ usedWay ++ '\n版本：' ++ tostring(ver));
	}
	else {
		log("hostc 全部安装方式均失败。");
		setState("安装失败", 0xEA4335);
		if(verbose){
			var r = winform.msgboxTest(
				'自动安装失败。\n\n若你已从网盘等渠道下载了 hostc 的离线 zip，\n'
				++ '可点「是」选择该文件进行本地安装。\n\n是否选择本地离线包？');
			if(r){ installFromLocalZip(); }
		}
	}
	return ok;
};

// 释放内置离线 zip（res 内嵌资源）到 hostc-data 目录
extractBundledOffline = function(){
	var zipPath = io.fullpath("\res\hostc-offline.zip");
	var data = string.load(zipPath);
	if(!data){
		// 内嵌资源在发布后也可通过虚拟路径读取
		data = ..io.getResource("/res/hostc-offline.zip");
	}
	if(!data){ log("未找到内置离线包。"); return false; }

	io.createDir(localRoot);
	var tmpZip = io.joinpath(localRoot, "_offline.zip");
	string.save(tmpZip, data);

	// 用 tar 解压 zip（Windows 自带 bsdtar，支持 zip）
	var p = process.popen.cmd(`tar -xf ` ++ tmpZip ++ ` -C ` ++ localRoot);
	var po, pe = p.readAll();
	io.remove(tmpZip);

	// 校验
	return io.exist(io.joinpath(localRoot, "hostc\dist\hostc.mjs"))
		or io.exist(io.joinpath(localRoot, "hostc\dist\index.js"));
};

// 从用户选择的本地 zip 安装（网盘下载的离线包）
installFromLocalZip = function(){
	import fsys.dlg;
	var path = fsys.dlg.open("离线包|*.zip","选择 hostc 离线 zip",,winform);
	if(!path) return false;
	io.createDir(localRoot);
	var p = process.popen.cmd(`tar -xf ` ++ path ++ ` -C ` ++ localRoot);
	p.readAll();
	if(resolveHostc()){
		log("已通过本地离线包安装 hostc。");
		setState("已安装 hostc", 0x34A853);
		winform.msgbox("本地离线包安装成功！");
		return true;
	}
	winform.msgbox("该离线包无效或已损坏。");
	return false;
};

// ========== 更新软件（本面板） ==========
// 本软件为单文件 EXE，无法在线热替换：检查 GitHub 最新 Release，有新版则引导用户前往下载
var compareVersion = function(a, b){
	// 按数字逐段比较；a>b 返回 1，相等 0，a<b 返回 -1
	var pa = string.split(a, ".");
	var pb = string.split(b, ".");
	for(i=1, math.max(#pa, #pb)){
		var x = tonumber(pa[[i]]) : 0;
		var y = tonumber(pb[[i]]) : 0;
		if(x > y) return 1;
		if(x < y) return -1;
	}
	return 0;
};

// 通过 git credential 获取本机存储的 GitHub token（用于提高 API 限额）；失败返回 null
var getGithubToken = function(){
	var tmpDir = string.expand("%TEMP%");
	var inFile = io.joinpath(tmpDir, "_hc_cred_in.txt");
	var outFile = io.joinpath(tmpDir, "_hc_cred_out.txt");
	string.save(inFile, 'protocol=https\r\nhost=github.com\r\n\r\n');
	var p = process.popen.cmd(`git credential fill < ` + inFile + ` > ` + outFile);
	if(p){ p.readAll(); p.close(); }
	var data = string.load(outFile);
	io.remove(inFile); io.remove(outFile);
	if(data){
		var tok = string.match(data, "password=([^\r\n]+)");
		if(tok && #tok >= 20) return tok;
	}
	return null;
};

var checkAppUpdate = function(){
	setState("正在检查软件更新...", 0xF5A623);
	winform.btnUpdateApp.disabled = true;
	log("检查软件（面板）更新，当前版本 v" ++ APP_VERSION ++ " ...");

	var token = getGithubToken();

	thread.invoke(
		function(winform, appVersion, releasesUrl, apiUrl, token){
			import inet.http;
			var writeLog = function(msg){
				winform.editLog.text ++= time().format("%H:%M:%S") ++ "  " ++ msg ++ '\r\n';
			};

			var http = inet.http();
			var headers = { ["User-Agent"]="hostc-gui" };
			if(token) headers.Authorization = "token " ++ token;
			http.setHeaders(headers);
			var ret, err = http.get(apiUrl);
			if(!ret){
				writeLog("检查软件更新失败：无法连接 GitHub（" ++ tostring(err) ++ "）。");
				winform.stateText.text = "未启动";
				winform.stateDot.bgcolor = 0x9AA0A6;
				winform.stateDot.redraw();
				winform.btnUpdateApp.disabled = false;
				winform.msgbox("检查软件更新失败：无法连接 GitHub，请检查网络后重试。");
				return;
			}

			import JSON;
			var data = JSON.parse(ret);
			if(!data || !data.tag_name){
				writeLog("检查软件更新失败：返回数据无法解析。");
				winform.stateText.text = "未启动";
				winform.stateDot.bgcolor = 0x9AA0A6;
				winform.stateDot.redraw();
				winform.btnUpdateApp.disabled = false;
				winform.msgbox("检查软件更新失败，请稍后重试。");
				return;
			}

			var latest = string.replace(tostring(data.tag_name), "^v", "");
			writeLog("最新发布版本：v" ++ latest);
			var cmp = compareVersion(latest, appVersion);

			// 回到界面线程复位状态并提示
			winform.invoke(function(){
				winform.stateText.text = "未启动";
				winform.stateDot.bgcolor = 0x9AA0A6;
				winform.stateDot.redraw();
				winform.btnUpdateApp.disabled = false;

				if(cmp <= 0){
					winform.msgbox("当前已是最新版本（v" ++ appVersion ++ "）。");
				}
				else {
					var ok = winform.msgboxTest(
						"发现新版本 v" + latest + "（当前 v" ++ appVersion ++ "）。\r\n\r\n"
						++ "本软件需下载新版 EXE 替换，是否现在打开下载页面？");
					if(ok) process.execute(releasesUrl + "/latest");
				}
			});
		},
		winform, APP_VERSION, RELEASES_URL,
		"https://api.github.com/repos/" ++ REPO_OWNER ++ "/" ++ REPO_NAME ++ "/releases/latest",
		token
	);
};

// ========== 更新 hostc（更新底层 npm 包） ==========

// 读取已安装的 hostc 版本
var getCurrentVersion = function(){
	var data = string.load(io.joinpath(globalRoot, "hostc\package.json"));
	if(data){
		var pkg = JSON.parse(data);
		if(pkg && pkg.version) return tostring(pkg.version);
	}
	return null;
};

var updateHostc = function(){
	// 更新依赖 npm，必须先有 Node.js
	if(!checkNode()){
		log("未检测到 Node.js，无法更新 hostc。");
		promptInstallNode();
		return;
	}

	// 更新前先停止运行中的隧道（避免文件占用导致更新失败）
	if(hostcProc){
		log("更新前先停止正在运行的隧道 ...");
		stopTunnel();
	}

	setState("正在检查更新...", 0xF5A623);
	log("检查 hostc 更新 ...");

	// 后台线程查询版本并升级，避免网络请求卡住界面
	thread.invoke(
		function(winform){
			import process.popen;

			var logLine = function(msg){
				winform.editLog.text ++= time().format("%H:%M:%S") ++ "  " ++ msg ++ '\r\n';
			};

			// 查询当前版本（全局或本地）
			var curVer = null;
			var vp0 = process.popen.cmd("npm ls -g hostc --version");
			// 直接读 package.json 更可靠，由界面线程的 resolveHostc 已定位，这里用 npm view 本地
			var curP = process.popen.cmd("npm root -g");
			var gpath = string.trim(curP.readAll());
			if(gpath){
				var data = string.load(io.joinpath(gpath, "hostc\package.json"));
				if(data){
					import JSON;
					var pkg = JSON.parse(data);
					if(pkg) curVer = tostring(pkg.version);
				}
			}
			logLine(curVer ? ("当前版本：" ++ curVer) : "未检测到已安装的 hostc。");

			// 查询最新版本：先官方后镜像
			var queryLatest = function(registry){
				var p = process.popen.cmd("npm view hostc version --registry=" ++ registry);
				var o = p.readAll();
				if(o){
					var v = string.trim(o);
					// aardio 模式数字用 \d（% 是对称操作符）；双引号内 \ 不转义，直接写
					if(string.find(v, "^\d+\.\d+")) return v;
				}
				return null;
			};
			var latest = queryLatest("https://registry.npmjs.org");
			if(latest) logLine("官方源最新版本：" ++ latest);
			else {
				logLine("官方源连接失败，尝试国内镜像 ...");
				latest = queryLatest("https://registry.npmmirror.com");
				if(latest) logLine("镜像最新版本：" ++ latest);
			}
			if(!latest){
				logLine("无法获取最新版本，请检查网络。");
				winform.stateText.text = "未启动";
				winform.stateDot.bgcolor = 0x9AA0A6;
				winform.stateDot.redraw();
				winform.msgbox("检查更新失败：无法连接 npm 注册表，请检查网络后重试。");
				return;
			}

			if(curVer == latest){
				logLine("已是最新版本，无需更新。");
				winform.stateText.text = "未启动";
				winform.stateDot.bgcolor = 0x9AA0A6;
				winform.stateDot.redraw();
				winform.msgbox("hostc 已是最新版本（" ++ latest ++ "）。");
				return;
			}

			// 执行升级（回到界面线程，复用多级安装容错）
			logLine("开始升级到 " ++ latest ++ " ...");
			// installHostc 在 UI 线程执行并自行刷新版本标签
			winform.invoke(function(){
				installHostc(false);
			});
		},
		winform
	);
};

// ========== 环境诊断 ==========

var runDoctor = function(){
	log("==== 运行环境诊断 ====");
	var allOk = true;

	// 1. Node.js
	if(checkNode()){
		log("[通过] Node.js 运行环境：" ++ nodeVersion);
	} else {
		log("[失败] 未检测到 Node.js，请先安装。");
		allOk = false;
	}

	// 2. hostc（重新解析，可能刚装好）
	resolveHostc();
	if(hostcEntry){
		var base = io.exist(io.joinpath(globalRoot,"hostc")) ? globalRoot : localRoot;
		var hv = readPkgVersion(base);
		log("[通过] hostc 已安装：v" ++ tostring(hv) ++ "（" ++ hostcMajor ++ ".x）");
	} else {
		log("[失败] 未检测到 hostc，点击「安装/修复 hostc」。");
		allOk = false;
	}

	// 3. 本地端口
	var port = tonumber(winform.editPort.text);
	if(port){
		var tcp = wsock.tcp.client();
		if(tcp.connectTimeout(LOCAL_HOST, port, 1.5)){
			log("[通过] 本地端口 " ++ LOCAL_HOST ++ ":" ++ port ++ " 有服务在监听。");
		} else {
			log("[警告] 本地端口 " ++ port ++ " 暂无服务监听（请先启动你的项目）。");
			allOk = false;
		}
	}

	// 4. 隧道服务器连通性（固定官方服务器 hostc.app）
	// 能拿到响应内容或 HTTP 状态码，即代表服务器可达
	var http = inet.http();
	var body = http.get("https://" ++ SERVER_HOST ++ "/");
	var code = http.lastStatusCode;
	if((body && #body) || code){
		log("[通过] 隧道服务器 " ++ SERVER_HOST ++ " 可连接"
			++ (code ? "（HTTP " ++ code ++ "）。" : "。"));
	} else {
		log("[警告] 暂时无法连接服务器 " ++ SERVER_HOST ++ "，可能是网络问题。");
	}

	log(allOk ? "诊断完成：环境正常，可以启动隧道。" : "诊断完成：存在需要处理的问题，详见上方。");
	log("======================");
};

// ========== 二维码弹窗 ==========

var qrForm = null;  // 外层引用：局部 qform 在函数返回后会被回收，导致窗口一闪即消失

var showQr = function(){
	if(!readyUrl) return;
	// 已打开则先关闭旧窗口（同时释放旧位图）
	if(qrForm){ qrForm.close(); qrForm = null; }

	var qr = qrencode.bitmap(readyUrl);
	var bmp = qr.copyBitmap(280);

	qrForm = win.form(text="公网地址二维码";right=319;bottom=379;bgcolor=0xFFFFFF;parent=winform);
	qrForm.add(
		qrPlus={cls="plus";left=20;top=20;right=300;bottom=300;bgcolor=0xFFFFFF;z=1};
		qrUrl={cls="static";text=readyUrl;left=10;top=310;right=310;bottom=334;center=1;color=0x202124;font=LOGFONT(h=-12);z=2};
		btnClose={cls="button";text="关闭";left=120;top=340;right=200;bottom=368;z=3}
	)
	qrForm.qrPlus.background = bmp;
	qrForm.btnClose.oncommand = function(){
		qrForm.close();
	};
	qrForm.onDestroy = function(){
		bmp.delete();
		qrForm = null;
	};
	qrForm.show();
};

// ========== 事件绑定 ==========

// 端口内容变化时实时更新「本地地址」（EN_CHANGE：每次编辑都会触发）
winform.editPort.onNotify = function(id, code){
	if(code == 0x300/*EN_CHANGE*/) syncLocalAddress();
};

winform.btnStart.oncommand = startTunnel;
winform.btnStop.oncommand = stopTunnel;
winform.btnDoctor.oncommand = runDoctor;
winform.btnUpdateApp.oncommand = checkAppUpdate;
winform.btnUpdateHostc.oncommand = updateHostc;
winform.btnInstall.oncommand = function(){
	if(!checkNode()){ promptInstallNode(); return; }
	if(hostcProc){
		log("修复前先停止正在运行的隧道 ...");
		stopTunnel();
	}
	if(installHostc(true)) refreshVersionDisplay();
};
winform.btnQr.oncommand = showQr;
winform.btnClear.oncommand = function(){
	winform.editLog.text = "";
};
winform.btnCopyUrl.oncommand = function(){
	if(readyUrl){
		win.clip.write(readyUrl);
		log("已复制公网地址：" ++ readyUrl);
	}
	else {
		winform.msgbox("隧道尚未就绪，暂无公网地址。");
	}
};

winform.onClose = function(){
	if(hostcProc){
		var proc = hostcProc;
		stopReadTimer();
		hostcProc = null;
		killProcSafe(proc);
	}
};

// ========== 启动 ==========
// res 目录在工程中配置为内嵌资源，虚拟路径在开发与发布后均可用
// 直接 LoadImage + WM_SETICON（winform.icon 内部封装的 SendMessageP 在此环境传参异常）
{
	var iconPath = io.fullpath("\res\icon.ico");
	var s,b = winform.dpiScale(16,32);
	var hSmall = ::LoadImage(,iconPath,1,s+0.5,s+0.5,0x10);
	var hBig = ::LoadImage(,iconPath,1,b+0.5,b+0.5,0x10);
	::User32.SendMessageW(winform.hwnd,0x80/*WM_SETICON*/,0,hSmall:hBig);
	::User32.SendMessageW(winform.hwnd,0x80,1,hBig:hSmall);
}
winform.show();
log("hostc 可视化面板已启动（软件 v" ++ APP_VERSION ++ "）。");
refreshVersionDisplay();

// 启动后静默检查一次更新（软件 + hostc），仅写入日志提示，不弹窗打扰
winform.setTimeout(
	function(){
		thread.invoke(
			function(winform, appVersion, apiLatest, apiReleases){
				import inet.http;
				// 1) 软件（面板）最新版本
				var h1 = inet.http();
				var r1 = h1.get(apiLatest);
				if(r1){
					import JSON;
					var j1 = JSON.parse(r1);
					if(j1 && j1.tag_name){
						var latestApp = string.replace(tostring(j1.tag_name), "^v", "");
						if(compareVersion(latestApp, appVersion) > 0){
							winform.editLog.text ++= time().format("%H:%M:%S")
								++ "  软件有新版本 v" ++ latestApp
								++ "，点击「检查软件更新」下载。" ++ '\r\n';
						}
					}
				}

				// 2) hostc 最新版本（需本机 Node；官方失败则镜像）
				import process.popen;
				var cur = null;
				var gr = string.trim(process.popen.cmd("npm root -g").readAll());
				if(gr){
					var d = string.load(io.joinpath(gr, "hostc\package.json"));
					if(d){ import JSON; var p = JSON.parse(d); if(p) cur = tostring(p.version); }
				}
				if(!cur){
					var d2 = string.load(io.joinpath(io.fullpath("/"), "hostc-data\hostc\package.json"));
					if(d2){ import JSON; var p2 = JSON.parse(d2); if(p2) cur = tostring(p2.version); }
				}
				var q = function(reg){
					var o = process.popen.cmd("npm view hostc version --registry=" ++ reg).readAll();
					if(o){ var v = string.trim(o); if(string.find(v,"^\d+\.\d+")) return v; }
					return null;
				};
				var latestHostc = q("https://registry.npmjs.org") : q("https://registry.npmmirror.com");
				if(cur && latestHostc && compareVersion(latestHostc, cur) > 0){
					winform.editLog.text ++= time().format("%H:%M:%S")
						++ "  hostc 有新版本 v" ++ latestHostc ++ "（当前 v" ++ cur
						++ "），点击「升级 hostc」。" ++ '\r\n';
				}
			},
			winform, APP_VERSION,
			"https://api.github.com/repos/" ++ REPO_OWNER ++ "/" ++ REPO_NAME ++ "/releases/latest",
			RELEASES_URL
		);
		return 0;
	},
	1500
);
if(!nodeVersion){
	log("警告：未检测到 Node.js，请先安装 Node.js 后再使用隧道功能。");
	// 启动时即弹窗一次引导安装（用户可选择暂不安装，稍后点任意功能会再次提示）
	promptInstallNode();
}
else {
	log("运行环境 Node.js " ++ nodeVersion);
	if(hostcEntry){
		log("已检测到 hostc v" ++ tostring(readPkgVersion(io.exist(io.joinpath(globalRoot,"hostc")) ? globalRoot : localRoot))
			++ "。");
	}
	else {
		log("提示：尚未安装 hostc，点击「安装/修复 hostc」或直接「启动隧道」自动安装。");
	}
}
win.loopMessage();
