// hostc 是基于 Cloudflare Workers 的内网穿透工具，给本地 HTTP/WebSocket 服务生成公网 URL

import win.ui;
import win.clip;
import process;
import process.popen;
import qrencode.bitmap;
import wsock.tcp.client;
import JSON;

/*DSG{{*/
